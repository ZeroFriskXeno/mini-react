{
	"version": 2,
	"builds": [
		{
			"src": "package.json",
			"use": "@vercel/static-build",
			"config": {
				"distDir": "client/dist"
			}
		},
		{
			"src": "server/src/server.ts",
			"use": "@vercel/node",
			"config": {
				"includeFiles": "server/dist/**"
			}
		}
	],
	"routes": [
		{
			"src": "/api/(.*)",
			"dest": "server/src/server.ts"
		},
		{
			"src": "/(.*)",
			"dest": "client/dist/index.html"
		}
	],
	"buildCommand": "pnpm run app-build",
	"outputDirectory": "client/dist",
	"env": {
		"NODE_ENV": "production"
	}
}
